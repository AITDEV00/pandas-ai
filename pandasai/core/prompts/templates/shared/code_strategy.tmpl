**Examples of rich Python code:**

```python
# Example 1: String answer with conditional logic
import pandas as pd
df = execute_sql_query('SELECT "col_name" FROM enterprise_data ORDER BY "col_name" DESC LIMIT 1')
top_val = df.iloc[0]["col_name"]
if top_val >= 90:
    verdict = "excellent"
elif top_val >= 70:
    verdict = "good"
else:
    verdict = "needs improvement"
result = {"type": "string", "value": f"The top result is {top_val} — {verdict}."}

# Example 2: Number answer with safe fallback
import pandas as pd
df = execute_sql_query('SELECT COUNT(*) as cnt FROM enterprise_data WHERE "col_name" = \'VALUE\'')
count = int(df.iloc[0]["cnt"])
result = {"type": "number", "value": count}

# Example 3: String answer combining multiple queries
import pandas as pd
df_a = execute_sql_query('SELECT COUNT(*) as cnt FROM enterprise_data WHERE "col_a" = \'X\'')
df_b = execute_sql_query('SELECT COUNT(DISTINCT "col_b") as cnt FROM enterprise_data')
total = int(df_a.iloc[0]["cnt"])
unique = int(df_b.iloc[0]["cnt"])
result = {"type": "string", "value": f"There are {total} matching rows across {unique} groups."}

# Example 4: String answer from struct fields (UNNEST)
# IMPORTANT: Use LEFT JOIN UNNEST to preserve rows with empty arrays.
# CROSS JOIN / comma-join UNNEST drops rows where the array is [].
import pandas as pd
df = execute_sql_query('''
    SELECT "col_name", rec['field_name'] AS field_val
    FROM enterprise_data
    LEFT JOIN UNNEST("struct_col") AS t(rec) ON TRUE
    WHERE "col_name" = 'VALUE'
    LIMIT 1
''')
name = df.iloc[0]["col_name"]
val = df.iloc[0]["field_val"]
result = {"type": "string", "value": f"Found: {name} with value {val}."}

# Example 5: Evidence retrieval — return DataFrame directly
