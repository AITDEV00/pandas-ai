df = execute_sql_query('''
    SELECT "Employee Name", "Department", "Basic Salary"
    FROM enterprise_data
    WHERE "Department" = 'IT'
    ORDER BY "Basic Salary" DESC
''')
result = {"type": "dataframe", "value": df}

