# LLM Configuration for Chat-Excel-Server
# These values are read by server/core/llm_setup.py on startup.

# Main LLM — DeepSeek-V4-Flash-0731 (validated for code generation)
# Served via the LiteLLM gateway. openai/ prefix routes through litellm's
# OpenAI-compatible provider (the structured path strips it before the gateway).
LLM_API_KEY=sk-WYz67mNLm248jhvqeSPShQ
LLM_BASE_URL=https://litellm.adeoaiengine.ecouncil.ae
LLM_MODEL_NAME=openai/deepseek-ai/DeepSeek-V4-Flash-0731
LLM_VERIFY_SSL=false
LLM_CONTEXT_WINDOW=250000

# Dedicated LLM for structured JSON calls (column selection + description
# auto-fill). Same DeepSeek model used for structured codegen via instructor.
STRUCTURED_LLM_MODEL_NAME=openai/deepseek-ai/DeepSeek-V4-Flash-0731
STRUCTURED_LLM_THINKING=false
COLUMN_SELECTION_USE_INSTRUCTOR=true
COLUMN_SELECTION_JSON_MODE=false

# DeepSeek code-generation sampling (validated on DeepSeek-V4-Flash-0731):
# temp 0.0 + instructor Mode.MD_JSON for deterministic structured codegen.
CODE_GENERATION_USE_INSTRUCTOR=true
CODE_GENERATION_TEMPERATURE=0.0
CODE_GENERATION_MAX_TOKENS=10000
COLUMN_SELECTION_MAX_TOKENS=10000

# TLS bypass (internal inference gateway)
NODE_TLS_REJECT_UNAUTHORIZED=0
SSL_CERT_FILE=
REQUESTS_CA_BUNDLE=
