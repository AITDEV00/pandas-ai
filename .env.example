# LLM Configuration for Chat-Excel-Server
# These values are read by server/core/llm_setup.py on startup.

LLM_API_KEY=sk-x_E_sNnprv1h2LKliRcpYF01jdfpNnex883nssoVcA8
LLM_BASE_URL=https://inference.adeoaiengine.ecouncil.ae/models/d974abd1-a213-409f-ad57-ed4512f21fa0/proxy/v1
LLM_MODEL_NAME=openai/deepseek-ai/DeepSeek-V4-Flash-0731
LLM_VERIFY_SSL=false
LLM_CONTEXT_WINDOW=250000

# Dedicated LLM for structured JSON calls (column selection + description
# auto-fill). diffusiongemma supports grammar-constrained structured generation,
# so column selection can use response_format for reliable JSON.
STRUCTURED_LLM_MODEL_NAME=openai/nvidia/diffusiongemma-26B-A4B-it-NVFP4
STRUCTURED_LLM_THINKING=false
# Use the instructor for structured column selection (Mode.MD_JSON). It extracts
# JSON from a code block without response_format, so it works with models that
# reject grammar-constrained decoding (diffusiongemma, DeepSeek DFLASH).
COLUMN_SELECTION_USE_INSTRUCTOR=true
# response_format is NOT needed for instructor (Mode.MD_JSON). Keep OFF.
COLUMN_SELECTION_JSON_MODE=false

# DeepSeek code-generation sampling. All sampling params left UNSET so
# the model applies its own defaults.
# CODE_GENERATION_TEMPERATURE=
# CODE_GENERATION_TOP_P=

# Toggle the code-generation (main) model's chain-of-thought. Set to "false"
# to pass {"chat_template_kwargs": {"thinking": false}} so the coding model
# does NOT spend time reasoning before generating code (faster, but less
# deliberate). Leave unset / "true" to keep thinking enabled.
CODE_GENERATION_THINKING=true

# Per-conversation logging: each /chat response is appended to
# {CONVERSATION_LOG_DIR}/{conversation_id}.jsonl
CONVERSATION_LOG_DIR=/home/jyao/ADEO/service/pandas-ai/run/conv_logs
